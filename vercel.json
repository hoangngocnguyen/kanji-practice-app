{
  "framework": "vite",
  "crons": [
    {
      "path": "/api/notifications?action=cron_daily_reminders",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    { 
      "source": "/api/(.*)", 
      "destination": "/api/$1" 
    },
    { 
      "source": "/((?!api/).*)", 
      "destination": "/index.html" 
    }
  ]
}
