{
  "manifest_version": 3,
  "name": "Luyện Kanji - Tra Cứu & Dịch Kanji Nhật-Việt",
  "short_name": "Luyện Kanji",
  "version": "2.0.0",
  "description": "Tiện ích tra cứu Kanji, nét vẽ động, phát âm, âm Hán Việt, dịch câu AI và xuất Anki flashcard trực tiếp từ mọi trang web.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["styles.css", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
