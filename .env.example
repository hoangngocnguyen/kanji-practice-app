# Gemini API Key (Cấu hình trên Vercel Environment Variables hoặc AI Studio)
# Nhận API key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase Frontend (Dùng cho Supabase Auth ở trình duyệt - an toàn công khai)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase Backend (Chỉ dùng trong Vercel Serverless Functions /api/* - KHÔNG dùng tiền tố VITE_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Web Push (VAPID) cho thông báo đẩy PWA (tạo bằng: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@luyenkanji.vercel.app

# Mã bảo mật kích hoạt nhắc Streak hằng ngày qua Cron (/api/notifications?action=cron_daily_reminders)
CRON_SECRET=

